{
  "name": "Critical Minerals Vibrant",
  "dataColors": [
    "#378DFF",
    "#DB6B04",
    "#FA04A6",
    "#05AB58",
    "#9C6BFF",
    "#A98D07",
    "#09A1B7",
    "#FF3434"
  ],
  "foreground": "#F4F6FB",
  "foregroundNeutralSecondary": "#A7B0C4",
  "foregroundNeutralTertiary": "#6E7891",
  "background": "#171A24",
  "backgroundLight": "#1F2431",
  "backgroundNeutral": "#262C3A",
  "tableAccent": "#378DFF",
  "good": "#05AB58",
  "neutral": "#A98D07",
  "bad": "#FF3434",
  "maximum": "#378DFF",
  "center": "#1C4C8F",
  "minimum": "#0E2338",
  "null": "#6E7891",
  "hyperlink": "#58A6FF",
  "visitedHyperlink": "#9C6BFF",
  "textClasses": {
    "callout": {
      "fontSize": 34,
      "fontFace": "Segoe UI Light",
      "color": "#F4F6FB"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#F4F6FB"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#A7B0C4"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#A7B0C4"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#171A24" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#2A3040" } },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "BottomRight",
            "color": { "solid": { "color": "#000000" } },
            "transparency": 70,
            "blur": 12
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "background": { "solid": { "color": "#171A24" } },
            "foreground": { "solid": { "color": "#6E7891" } },
            "transparency": 0,
            "showVisualInformationButton": true
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#F4F6FB" } },
            "background": { "solid": { "color": "#00000000" } },
            "alignment": "left",
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "subTitle": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#A7B0C4" } },
            "alignment": "left",
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": true,
            "labelColor": { "solid": { "color": "#A7B0C4" } },
            "fontSize": 10,
            "titleFontSize": 10,
            "titleColor": { "solid": { "color": "#6E7891" } },
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": true,
            "labelColor": { "solid": { "color": "#A7B0C4" } },
            "fontSize": 10,
            "titleFontSize": 10,
            "titleColor": { "solid": { "color": "#6E7891" } },
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#262C3A" } },
            "gridlineThickness": 1,
            "gridlineStyle": "solid"
          }
        ],
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#F4F6FB" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopCenter",
            "showTitle": false,
            "labelColor": { "solid": { "color": "#A7B0C4" } },
            "fontSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#0E1016" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#080A0F" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#1F2431" } },
            "transparency": 0
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#F4F6FB" } },
            "fontSize": 30,
            "fontFamily": "Segoe UI Light"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#A7B0C4" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "dataLabels": [
          { "color": { "solid": { "color": "#F4F6FB" } }, "fontSize": 18 }
        ],
        "categoryLabels": [
          { "color": { "solid": { "color": "#A7B0C4" } }, "fontSize": 10 }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#1F2431" } },
            "transparency": 0
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#A7B0C4" } },
            "background": { "solid": { "color": "#1F2431" } },
            "outline": "None",
            "fontSize": 10
          }
        ],
        "selection": [
          { "selectAllCheckboxEnabled": false, "singleSelect": false }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#262C3A" } },
            "rowPadding": 6,
            "outlineColor": { "solid": { "color": "#2A3040" } }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#A7B0C4" } },
            "backColor": { "solid": { "color": "#1F2431" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold",
            "outline": "BottomOnly"
          }
        ],
        "values": [
          {
            "fontColor": { "solid": { "color": "#F4F6FB" } },
            "backColor": { "solid": { "color": "#171A24" } },
            "backColorSecondary": { "solid": { "color": "#1A1E29" } },
            "fontSize": 10,
            "outline": "None"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#A7B0C4" } },
            "backColor": { "solid": { "color": "#1F2431" } },
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColor": { "solid": { "color": "#F4F6FB" } },
            "backColor": { "solid": { "color": "#171A24" } },
            "fontSize": 10
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#F4F6FB" } },
            "fontSize": 10
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }]
      }
    },
    "actionButton": {
      "*": {
        "fill": [
          {
            "show": true,
            "fillColor": { "solid": { "color": "#1F2431" } },
            "transparency": 0
          }
        ],
        "text": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#F4F6FB" } },
            "fontSize": 10
          }
        ],
        "outline": [
          {
            "show": true,
            "lineColor": { "solid": { "color": "#2A3040" } },
            "weight": 1
          }
        ]
      }
    },
    "shape": {
      "*": {
        "dropShadow": [{ "show": false }]
      }
    }
  }
}
